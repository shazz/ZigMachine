#!/bin/sh
# Pre-commit: CHEAP checks only (well under a second). Several Claude sessions
# commit here many times an hour, so rebuilding every screen belongs in pre-push,
# not here. Skip once with `git commit --no-verify`.
cd "$(git rev-parse --show-toplevel)" || exit 1
staged=$(git diff --cached --name-only)

# 1. A scene's three registration points agree (build.zig cart_names, cart.zig,
#    catalog.zig), and every menu entry has a disk to boot: tools/channels.py
#    --check reads the catalog and fails on a channel without its .zmd.
if echo "$staged" | grep -qE '^(apps/zig/cart\.zig|apps/zig/scenes/catalog\.zig|build\.zig|docs/channels\.json|docs/demo-.*\.zmd)$'; then
    python3 tools/channels.py --check > /dev/null || {
        python3 tools/channels.py --check
        echo "pre-commit: docs/channels.json disagrees with the catalog (run tools/prepare_pages.sh)"
        exit 1
    }
fi

# 2. No stray conflict markers in staged source.
if git diff --cached -U0 -- '*.zig' '*.js' '*.mjs' '*.py' '*.sh' '*.html' | grep -qE '^\+(<<<<<<< |>>>>>>> |=======$)'; then
    echo "pre-commit: staged changes contain merge conflict markers"
    exit 1
fi

# 3. A scene or engine change without any rebuilt cart is almost always a
#    forgotten rebuild. It is only a warning: the pre-push gate enforces it.
if echo "$staged" | grep -qE '^(apps/zig/|libs/zig/|machine/|rom/)' && ! echo "$staged" | grep -qE '^docs/.*\.(wasm|zmd)$'; then
    echo "pre-commit: note: source staged without rebuilt docs/ carts; pre-push will rebuild and check (tools/prepare_pages.sh)"
fi
exit 0
