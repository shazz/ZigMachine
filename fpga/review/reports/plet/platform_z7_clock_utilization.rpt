# Location of BUFG Primitives 
set_property LOC BUFGCTRL_X0Y3 [get_cells BUFG_4]
set_property LOC BUFGCTRL_X0Y0 [get_cells BUFG_3]
set_property LOC BUFGCTRL_X0Y4 [get_cells BUFG_2]
set_property LOC BUFGCTRL_X0Y1 [get_cells BUFG]
set_property LOC BUFGCTRL_X0Y5 [get_cells BUFG_5]
set_property LOC BUFGCTRL_X0Y2 [get_cells BUFG_1]

# Location of IO Primitives which is load of clock spine

# Location of clock ports
set_property LOC IOB_X0Y24 [get_ports PL_CLK_50M]

# Clock net "sys_rst" driven by instance "BUFG_4" located at site "BUFGCTRL_X0Y3"
#startgroup
create_pblock {CLKAG_sys_rst}
add_cells_to_pblock [get_pblocks  {CLKAG_sys_rst}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="sys_rst"}]]]
resize_pblock [get_pblocks {CLKAG_sys_rst}] -add {CLOCKREGION_X0Y0:CLOCKREGION_X0Y0 CLOCKREGION_X0Y1:CLOCKREGION_X0Y1 CLOCKREGION_X1Y0:CLOCKREGION_X1Y0}
#endgroup

# Clock net "make_z7_clkout_buf3" driven by instance "BUFG_3" located at site "BUFGCTRL_X0Y0"
#startgroup
create_pblock {CLKAG_make_z7_clkout_buf3}
add_cells_to_pblock [get_pblocks  {CLKAG_make_z7_clkout_buf3}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="make_z7_clkout_buf3"}]]]
resize_pblock [get_pblocks {CLKAG_make_z7_clkout_buf3}] -add {CLOCKREGION_X1Y0:CLOCKREGION_X1Y0 CLOCKREGION_X1Y1:CLOCKREGION_X1Y1}
#endgroup

# Clock net "make_z7_clkout_buf2" driven by instance "BUFG_2" located at site "BUFGCTRL_X0Y4"
#startgroup
create_pblock {CLKAG_make_z7_clkout_buf2}
add_cells_to_pblock [get_pblocks  {CLKAG_make_z7_clkout_buf2}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="make_z7_clkout_buf2"}]]]
resize_pblock [get_pblocks {CLKAG_make_z7_clkout_buf2}] -add {CLOCKREGION_X0Y0:CLOCKREGION_X0Y0 CLOCKREGION_X0Y1:CLOCKREGION_X0Y1 CLOCKREGION_X1Y0:CLOCKREGION_X1Y0 CLOCKREGION_X1Y1:CLOCKREGION_X1Y1}
#endgroup

# Clock net "make_z7_clkout_buf0" driven by instance "BUFG" located at site "BUFGCTRL_X0Y1"
#startgroup
