#!/bin/sh
# Wi-Fi: join the network the SD card names, if there is a dongle and a file.
# The file is KESTREL/wifi.conf on the card's FAT partition, in wpa_supplicant's format
# (fpga/docs/PREREQUISITES.md, "Wi-Fi"); S99glass has mounted the card read-only at /mnt/sd
# before this runs. No file, or no wlan0: nothing happens, the console boots as before.
# The address comes by DHCP in the background, so a missing network never delays the boot.
CONF=/mnt/sd/KESTREL/wifi.conf
RUN=/tmp/wifi

case "$1" in
start)
    [ -f "$CONF" ] || exit 0
    i=0
    while [ ! -e /sys/class/net/wlan0 ] && [ $i -lt 10 ]; do sleep 1; i=$((i + 1)); done
    if [ ! -e /sys/class/net/wlan0 ]; then
        echo "wifi: $CONF is there but no wlan0 (no supported dongle)" >&2
        exit 0
    fi
    mkdir -p -m 0700 $RUN
    # A copy: the card's file may have DOS line ends; wpa_supplicant reads its own copy.
    tr -d '\r' < "$CONF" > $RUN/wpa.conf && chmod 0600 $RUN/wpa.conf
    ip link set wlan0 up
    wpa_supplicant -B -i wlan0 -c $RUN/wpa.conf -f $RUN/wpa.log || {
        echo "wifi: wpa_supplicant failed, see $RUN/wpa.log" >&2
        exit 0
    }
    udhcpc -b -i wlan0 -p $RUN/udhcpc.pid >/dev/null 2>&1
    echo "wifi: joining (log $RUN/wpa.log)"
    ;;
stop)
    [ -f $RUN/udhcpc.pid ] && kill "$(cat $RUN/udhcpc.pid)" 2>/dev/null
    killall wpa_supplicant 2>/dev/null
    ;;
esac
