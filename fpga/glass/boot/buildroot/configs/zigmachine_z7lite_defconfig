# ZigMachine glass on the MicroPhase Z7-Lite (docs/FPGA_GLASS.md, "Boot flow").
#   make BR2_EXTERNAL=<repo>/fpga/glass/boot/buildroot zigmachine_z7lite_defconfig && make
# fpga/glass/boot/build_planA.sh runs the whole build (it generates ps7_init_gpl.c first).
# Outputs used by fpga/tools/glass_sd.py: images/zImage, images/zigmachine-z7lite.dtb,
# images/rootfs.cpio.uboot; plan A's own BOOT.BIN: images/boot.bin (U-Boot SPL) + u-boot.img.
BR2_arm=y
BR2_cortex_a9=y
BR2_ARM_ENABLE_NEON=y
BR2_ARM_ENABLE_VFP=y
BR2_ARM_FPU_VFPV3D16=y
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_TARGET_GENERIC_HOSTNAME="zigmachine"
BR2_TARGET_GENERIC_ISSUE="ZigMachine"
BR2_TARGET_GENERIC_GETTY_PORT="ttyPS0"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_KEEP=y
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_ZIGMACHINE_PATH)/overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_ZIGMACHINE_PATH)/post-build.sh"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_DEFCONFIG="multi_v7"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_ZIGMACHINE_PATH)/linux.fragment"
BR2_LINUX_KERNEL_ZIMAGE=y
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_CUSTOM_DTS_PATH="$(BR2_EXTERNAL_ZIGMACHINE_PATH)/../zigmachine-z7lite.dts"
# Our own BOOT.BIN: U-Boot SPL (no Xilinx FSBL, no Vitis) + u-boot.img, from the
# u-boot-xlnx tag Buildroot's zynq_zed_defconfig uses (patches/uboot/uboot.hash pins it).
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_ZIGMACHINE_PATH)/patches"
BR2_TARGET_UBOOT=y
BR2_TARGET_UBOOT_BUILD_SYSTEM_KCONFIG=y
BR2_TARGET_UBOOT_CUSTOM_TARBALL=y
BR2_TARGET_UBOOT_CUSTOM_TARBALL_LOCATION="$(call github,Xilinx,u-boot-xlnx,xlnx_rebase_v2025.01_2025.2)/xlnx_rebase_v2025.01_2025.2.tar.gz"
BR2_TARGET_UBOOT_BOARD_DEFCONFIG="xilinx_zynq_virt"
BR2_TARGET_UBOOT_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_ZIGMACHINE_PATH)/uboot.fragment"
BR2_TARGET_UBOOT_CUSTOM_DTS_PATH="$(BR2_EXTERNAL_ZIGMACHINE_PATH)/../uboot/zynq-z7lite.dts"
BR2_TARGET_UBOOT_CUSTOM_MAKEOPTS="DEVICE_TREE=zynq-z7lite"
BR2_TARGET_UBOOT_NEEDS_DTC=y
BR2_TARGET_UBOOT_NEEDS_OPENSSL=y
BR2_TARGET_UBOOT_NEEDS_GNUTLS=y
BR2_TARGET_UBOOT_FORMAT_IMG=y
BR2_TARGET_UBOOT_SPL=y
BR2_TARGET_UBOOT_SPL_NAME="spl/boot.bin"
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_UIMAGE=y
# BR2_TARGET_ROOTFS_TAR is not set
# The remote shell over the RJ45 (docs/FPGA_GLASS.md, "Remote shell"): DHCP on
# eth0 (ifupdown + busybox udhcpc, S40network), ssh (dropbear, S50dropbear, keys
# only: root has no password), and mDNS so the board answers as zigmachine.local
# (avahi-daemon, S50avahi-daemon).
BR2_SYSTEM_DHCP="eth0"
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_AVAHI=y
BR2_PACKAGE_AVAHI_DAEMON=y
