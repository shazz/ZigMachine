# What the glass needs on top of multi_v7 (most of it is already there).
# /dev/mem for the GP0 registers and the cart window. STRICT_DEVMEM stays on:
# the window is reserved no-map RAM and GP0 is not claimed by a driver, so
# both are allowed; IO_STRICT_DEVMEM would refuse them if a driver ever were.
CONFIG_DEVMEM=y
CONFIG_IO_STRICT_DEVMEM=n
# USB host on the PS's ChipIdea controller, ULPI PHY, keyboards and pads.
CONFIG_USB=y
CONFIG_USB_CHIPIDEA=y
CONFIG_USB_CHIPIDEA_HOST=y
CONFIG_USB_ULPI=y
CONFIG_NOP_USB_XCEIV=y
CONFIG_USB_HID=y
CONFIG_HID_GENERIC=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_JOYDEV=y
# The SD card and its FAT partition.
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_OF_ARASAN=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
