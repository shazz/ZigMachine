# What the glass needs on top of multi_v7 (most of it is already there).
# /dev/mem for the GP0 registers and the cart window. STRICT_DEVMEM stays on:
# the window is reserved no-map RAM and GP0 is not claimed by a driver, so
# both are allowed; IO_STRICT_DEVMEM would refuse them if a driver ever were.
CONFIG_DEVMEM=y
CONFIG_IO_STRICT_DEVMEM=n
# USB host on the PS's ChipIdea controller, ULPI PHY, keyboards and pads.
CONFIG_USB=y
CONFIG_USB_CHIPIDEA=y
CONFIG_USB_CHIPIDEA_HOST=y
CONFIG_USB_ULPI=y
CONFIG_NOP_USB_XCEIV=y
CONFIG_USB_HID=y
CONFIG_HID_GENERIC=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_JOYDEV=y
# Pads whose USB HID is not generic enough for hid-generic. No kernel version is
# pinned (multi_v7 + Buildroot's default), so these names were checked against
# 6.14's Kconfig; HID_PLAYSTATION needs >= 5.12, HID_NINTENDO >= 5.16.
CONFIG_INPUT_JOYSTICK=y
# Xbox 360/One and XInput pads, including most 8BitDo pads in X mode.
CONFIG_JOYSTICK_XPAD=y
# DualShock 3/4 (hid-sony), DualShock 4/DualSense (hid-playstation), Switch Pro
# and Joy-Cons (hid-nintendo), Microsoft SideWinder and some Xbox pads over HID.
# The LED class is a hard dependency of all three Sony/Nintendo drivers.
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_CLASS_MULTICOLOR=y
CONFIG_HID_SONY=y
CONFIG_HID_PLAYSTATION=y
CONFIG_HID_NINTENDO=y
CONFIG_HID_MICROSOFT=y
# The SD card and its FAT partition.
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_OF_ARASAN=y
CONFIG_VFAT_FS=y
# The USB floppy (KOS's drive A: glass/src/app_source.zig mounts /dev/sdX vfat) and USB
# sticks. multi_v7 has these =y already; pinned because post-build.sh drops every module.
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_STORAGE=y
CONFIG_MSDOS_PARTITION=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
# Ethernet: the PS's GEM0 (macb), routed through EMIO to the RTL8201F 10/100 PHY
# on PL pins (MII + MDIO), so it needs the bitstream's EMIO wiring too.
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_IP_MULTICAST=y
CONFIG_NETDEVICES=y
CONFIG_NET_VENDOR_CADENCE=y
CONFIG_MACB=y
CONFIG_PHYLIB=y
CONFIG_REALTEK_PHY=y
# Wi-Fi through a USB dongle on the hub (fpga/docs/PREREQUISITES.md, "Wi-Fi"). Built in, as
# everything here: post-build.sh drops the module tree, and built in, brcmfmac's vendor
# part (brcmfmac-wcc) needs no modprobe. Tested on the board 9 Nov 2026 with a Broadcom
# BCM43143 dongle (USB 0a5c:bd1e, the Raspberry Pi one), firmware 6.10.198.66.
# multi_v7 has these =m and BRCMFMAC_USB off.
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_BROADCOM=y
CONFIG_BRCMUTIL=y
CONFIG_BRCMFMAC=y
CONFIG_BRCMFMAC_USB=y
