# Generated or fetched: `make setup` / `make memmap` recreate all of it.
.venv/
.tools/
build/
gen/
__pycache__/
# Board files fetched by tools/fetch_board.sh: vendor-licensed, never committed.
boards/*/board.xdc
boards/*/vendor/
boards/*/ps7_init*
# U-Boot SPL's PS7 init, read out of zeST's FSBL by tools/ps7_from_bootbin.py (build_planA.sh)
glass/boot/uboot/ps7_init_gpl.c
# sbt output of vexgen/ (custom VexRiscv netlists)
vexgen/target/
vexgen/project/target/
vexgen/project/project/
# the glass program (zig build)
glass/.zig-cache/
glass/zig-out/
