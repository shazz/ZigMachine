---
// A bare file name from a URL parameter (?disk=demo-x.zmd, ?demo=demo-x.wasm, ?c=kos-c.img: links
// made before the site had folders) lives in its folder; a path with a "/" is taken as given.
function siteUrl(name, dir) {
    return name.includes("/") ? name : dir + name;
}

