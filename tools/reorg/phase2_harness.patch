>>>
<<<
    (root / "apps").mkdir()
---
    (root / "apps" / "harness").mkdir(parents=True)
>>>
<<<
        (root / "apps" / name).write_text(text)
---
        (root / "apps" / "harness" / name).write_text(text)
>>>
<<<
        self.assertEqual(self.scope("M\tapps/big_fixture.json"), ["big_demo"])
