>>>

# The repo root, from a harness one level deeper than before.
=== apps/harness/sdk_check.mjs
<<<
const ROOT = path.resolve(path.dirname(new URL(import.meta.url).pathname), "..");
---
const ROOT = path.resolve(path.dirname(new URL(import.meta.url).pathname), "../..");
>>>

